{% extends 'export/pdf-layout.html.twig' %}

{% set showUserColumn = false %}
{% set showRateColumn = false %}
{% set showRateBudget = false %}
{% set showTimeBudget = false %}
{% set showCustomerSummary = false %}
{% set showTotalSummary = false %}
{% set showPageBreak = false %}
{% set logo_svg = logo_svg|default('<svg cursor="default" enable-background="new" height="130" viewBox="0 0 440 440" width="130" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"><radialGradient id="a" cx="611" cy="41.266644" gradientTransform="matrix(1.1673343 0 0 1.4196623 -102.24121 -19.722475)" gradientUnits="userSpaceOnUse" r="160.5"><stop offset="0" stop-color="#01fd00"/><stop offset="1" stop-color="#009d39"/></radialGradient><radialGradient id="b" cx="873.78265" cy="-16.37981" gradientTransform="matrix(1.9295131 -1.1140049 1.1550268 2.0005649 -1087.6858 1104.8947)" gradientUnits="userSpaceOnUse" r="55.747124"><stop offset="0" stop-color="#f9f9f9"/><stop offset="1" stop-color="#fff"/></radialGradient><linearGradient id="c" gradientUnits="userSpaceOnUse" x1="611.14288" x2="610.57141" y1="234.57143" y2="-110.91601"><stop offset="0" stop-color="#f2f2f2"/><stop offset="1" stop-color="#f2f2f2"/></linearGradient><g transform="translate(-390.56693 181.56689)"><g><circle cx="611" cy="38" fill="url(#c)" r="187.776825"/><circle cx="611" cy="38" fill="url(#a)" r="166.285645" stroke="#fff" stroke-linejoin="round" stroke-width="3"/><path d="m571.156433 108.308197 110-63.999998-110-64z" fill="url(#b)" fill-rule="evenodd"/></g><g fill="#c7efc4" fill-rule="evenodd"><rect height="32" opacity=".5" ry="7" transform="matrix(-.83616052 -.5484848 .5484848 -.83616052 0 0)" width="14" x="-542.46875" y="419.410309"/><rect height="32" opacity=".5" ry="7" transform="matrix(-.45720822 -.88935968 .88935968 -.45720822 0 0)" width="14" x="-320.158203" y="642.978027"/><rect height="41" opacity=".5" ry="9" transform="rotate(-90)" width="18" x="-48.536366" y="718.754395"/><rect height="32" opacity=".5" ry="7" transform="matrix(.47159375 -.88181593 .88181593 .47159375 0 0)" width="14" x="244.405457" y="673.798523"/><rect height="32" opacity=".5" ry="7" transform="matrix(-.8503618 .52619845 -.52619845 -.8503618 0 0)" width="14" x="-505.884949" y="-503.867859"/><rect height="41" opacity=".5" ry="9" transform="scale(-1)" width="18" x="-620.297424" y="-187.942719"/><rect height="32" opacity=".5" ry="7" transform="matrix(-.84033379 -.54206929 .54206929 -.84033379 0 0)" width="14" x="-539.16571" y="148.581909"/><rect height="32" opacity=".5" ry="7" transform="matrix(-.45720822 -.88935968 .88935968 -.45720822 0 0)" width="14" x="-319.728088" y="374.804901"/><rect height="41" opacity=".5" ry="9" transform="rotate(-90)" width="18" x="-48.536366" y="460.964569"/><rect height="32" opacity=".5" ry="7" transform="matrix(.47159375 -.88181593 .88181593 .47159375 0 0)" width="14" x="250.841736" y="406.195648"/><rect height="32" opacity=".5" ry="7" transform="matrix(-.849305 .52790248 -.52790248 -.849305 0 0)" width="14" x="-505.957611" y="-236.959518"/><g transform="scale(-1)"><rect height="41" opacity=".5" ry="9" width="18" x="-633.02533" y="69.120789"/><rect height="41" opacity=".5" ry="9" width="18" x="-606.761353" y="69.120789"/></g></g></g></svg>') %}

{% block title %}Detailed Report{% endblock %}

{% block pdf_footer %}{% endblock %}

{% block styles %}
    {{ parent() }}
    <style>
        body {
            font-family: Helvetica, Arial, sans-serif;
            color: #1f1f1f;
        }
        .header-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 24px;
        }
        .header-table td {
            vertical-align: top;
        }
        .header-left h1 {
            font-size: 22pt;
            margin: 0 0 6px 0;
            font-weight: 600;
        }
        .date-range {
            color: #666666;
            font-size: 10.5pt;
        }
        .header-right {
            text-align: right;
            width: 150px;
        }
        .logo-inline {
            width: 130px;
            height: 130px;
            display: inline-block;
        }
        .logo-inline svg {
            width: 130px;
            height: 130px;
        }
        .totals {
            padding: 12px 14px;
            margin: 0;
        }
        .totals-table {
            border-collapse: collapse;
            margin: 6px 0 18px 0;
        }
        .totals-table td {
            padding-right: 40px;
            vertical-align: top;
        }
        .totals-label {
            color: #8a8a8a;
            font-size: 8.5pt;
            letter-spacing: 0.5px;
        }
        .totals-value {
            font-size: 18pt;
            font-weight: 600;
            margin-top: 6px;
        }
        table.report {
            width: 100%;
            border-collapse: collapse;
            font-size: 9.5pt;
        }
        table.report thead th {
            text-align: left;
            font-size: 8.5pt;
            color: #8a8a8a;
            background: transparent !important;
            border: none !important;
            padding: 0 4px 8px 4px;
        }
        table.report thead tr {
            border-bottom: 2px solid #e5e5e5;
        }
        table.report thead th.col-duration,
        table.report thead th.col-date {
            text-align: right;
        }
        table.report tbody td {
            vertical-align: top;
            border-bottom: 1px solid #ededed;
            padding: 10px 4px;
        }
        .col-duration,
        .col-date {
            text-align: right;
            white-space: nowrap;
            border-left: 1px solid #e5e5e5;
            padding-left: 10px;
        }
        .time-entry {
            font-weight: 600;
        }
        .tags {
            color: #444444;
            font-size: 9pt;
            margin-top: 6px;
        }
        .tag-dot {
            display: inline-block;
            width: 6px;
            height: 6px;
            background: #e23a3a;
            border-radius: 50%;
            margin-right: 6px;
            position: relative;
            top: -1px;
        }
        .tag-sep {
            color: #999999;
            margin: 0 6px;
        }
    </style>
{% endblock %}

{% block summary %}{% endblock %}

{% block items %}
    {% set totalDuration = 0 %}
    {% for entry in entries %}
        {% set totalDuration = totalDuration + entry.duration %}
    {% endfor %}
    {% set totalHours = totalDuration / 3600 %}
    {% set totalDays = totalHours / 8 %}

    <table class="header-table">
        <tr>
            <td class="header-left">
                <h1>Detailed Report</h1>
                {% if query is defined %}
                    <div class="date-range">{{ query.begin|date_format('d-m-Y') }} - {{ query.end|date_format('d-m-Y') }}</div>
                {% endif %}
            </td>
            <td class="header-right">
                <span class="logo-inline">{{ logo_svg|raw }}</span>
            </td>
        </tr>
    </table>

    <table class="totals-table">
        <tr>
            <td>
                <div class="totals">
                    <div class="totals-label">TOTAL HOURS</div>
                    <div class="totals-value">{{ totalDuration|duration(false) }}</div>
                </div>
            </td>
            <td>
                <div class="totals">
                    <div class="totals-label">TOTAL DAYS</div>
                    <div class="totals-value">{{ totalDays|number_format(2, ',', '') }}</div>
                </div>
            </td>
        </tr>
    </table>

    <table class="report">
        <thead>
        <tr>
            <th>TIME ENTRY</th>
            <th class="col-duration">DURATION</th>
            <th class="col-date">DATE</th>
        </tr>
        </thead>
        <tbody>
        {% for entry in entries %}
            <!-- CONTENT_PART -->
            <tr>
                <td class="time-entry">
                    {% if entry.description is not empty %}
                        {{ entry.description|desc2html }}
                    {% elseif entry.activity is not null %}
                        {{ entry.activity.name }}
                    {% endif %}
                    {% if entry.tagsAsArray is defined and entry.tagsAsArray is not empty %}
                        <div class="tags">
                            {% for tag in entry.tagsAsArray %}
                                <span class="tag-dot"></span>{{ tag }}{% if not loop.last %}<span class="tag-sep">&#183;</span>{% endif %}
                            {% endfor %}
                        </div>
                    {% endif %}
                </td>
                <td class="col-duration">
                    {{ entry.duration|duration(false) }}
                </td>
                <td class="col-date">
                    {{ entry.begin|date_format('d-m-Y') }}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
